[Unit]
Description=Switch Charging V2 - Fleet network watchdog
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/Code/Switch_Charging_V2
ExecStart=/usr/bin/python3 -m server.ap_fallback
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
